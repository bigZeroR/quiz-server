# Storage (user-generated, not source)
storage/audio/*
storage/uploads/*
storage/tmp/*
storage/logs/*
!storage/audio/.gitkeep
!storage/uploads/.gitkeep
!storage/tmp/.gitkeep
!storage/logs/.gitkeep

# User quiz data (optional — uncomment if you don't want quizzes in repo)
# data/*.json
# !data/sample_quiz.json
# !data/.gitkeep

# Backups
*.bak
*.tmp
*.orig

# Vendor dependencies (cloned via script)
vendor/

