# Copy to .env — the app will load it automatically if python-dotenv is installed.

# ── Network ─────────────────────────────────
# 127.0.0.1  → local only (safe default)
# 0.0.0.0    → reachable from your LAN (make sure you trust the network!)
QUIZ_HOST=127.0.0.1
QUIZ_PORT=5000

# Never enable debug on a shared network.
QUIZ_DEBUG=0

# Leave empty to auto-generate a random key on each start.
# Set a stable value if you want sessions to survive restarts:
#   python -c "import secrets; print(secrets.token_hex(32))"
QUIZ_SECRET_KEY=

# ── Video API ───────────────────────────────
# Comma-separated list of directories /api/v1/video/* may read from.
# storage/videos is always allowed.
# Example:
# QUIZ_VIDEO_ROOTS=~/Videos,~/Downloads,/mnt/media
QUIZ_VIDEO_ROOTS=

# ── AI (optional) ───────────────────────────
QUIZ_AI_API_KEY=
QUIZ_AI_BASE_URL=https://api.openai.com/v1
QUIZ_AI_MODEL=gpt-4o-mini
QUIZ_AI_TIMEOUT=60

# ── Audio import (optional) ─────────────────
# Comma-separated dirs /api/v1/audio/files/import may copy from.
# Empty = legacy behavior (any readable file), but system dirs
# (/etc,/proc,/sys,/dev,/boot,/root) are always blocked.
QUIZ_AUDIO_IMPORT_ROOTS=
